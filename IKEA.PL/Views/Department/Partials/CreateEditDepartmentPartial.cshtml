@model DepartmentVM
<form method="post" asp-action="@ViewBag.Action" class="col-6"> @* Defualt Method ==> Post *@
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-group mb-3">
        @* <label class="form-label" for="Code">Code</label> *@
        @* <input id="Code" name="Code" type="text"/> *@
        <label class="form-label" asp-for="Code">Code</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>  @*  Code Is Required{Validation} *@
    </div>
    <div class="form-group mb-1">
        <label class="form-label" asp-for="Name">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span> @*  Name Is Required{Validation} *@
    </div>
    <div class="form-group mb-3">
        <label class="form-label" asp-for="Description">Description</label>
        <textarea class="form-control" asp-for="Description"></textarea>
    </div>
    <div class="form-group mb-3">
        <label class="form-label" asp-for="CreationDate">Creation_Date</label>
        <input asp-for="CreationDate" type="date" class="form-control" />
    </div>
    @if (ViewBag.Action == "Create")
    {
        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" />
            <a asp-action="Index" class="btn btn-dark">Back To List</a>
        </div>
    }
    else
    {
        <div class="mt-4 m-auto">
            <input class="btn btn-success" type="submit" value="Edit" />
            <a asp-action="Index" class="btn btn-dark">Back To List</a>
        </div>
    }
</form>