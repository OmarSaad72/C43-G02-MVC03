@model IEnumerable<DepartmentToReturnDTO>;
@{
    ViewData["Title"] = "Index";
}

<h1 class="">All_Departments</h1>
<br />
<br />
<a asp-action="Create" class="btn btn-primary">Create Department</a>
<br />
@if (Model.Count() > 0)
{
    <table class="table table-striped table table-hover mt-3">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(d => d.Code)</th>
                <th>@Html.DisplayNameFor(d => d.Name)</th>
                <th>@Html.DisplayNameFor(d => d.CreationDate)</th>
                <th>@Html.DisplayNameFor(d => d.Description)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var dep in Model)
            {
                <tr>
                    <td>@dep.Code</td>
                    <td>@dep.Name</td>
                    <td>@dep.CreationDate</td>
                    <td>@dep.Description</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@dep.Id" class="btn btn-primary"><i class="fas fa-eve"></i> Details</a>

                    </td>
                    <td>
                        <a asp-action="Update" asp-route-id="@dep.Id" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
                    </td>
                    @* <td> *@
                    @*     <a asp-action="Delete" asp-route-id="@dep.Id" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</a> *@
                    @* </td> *@
                    <td>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="fas fa-trash"> Delete</i>
                        </button>
                    </td>
                    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="exampleModalLabel">DeleteDepartment</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Are You Sure To Delete This Department
                                </div>
                                <div class="modal-footer">
                                    <form asp-action="Delete" asp-route-id="@dep.Id" method="post">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Delete</button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h3 class="text-center">No Departments Found!</h3>
    </div>
}