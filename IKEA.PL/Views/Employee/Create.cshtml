@using IKEA.BLL.Models.Common.Enums
@model CreatedEmployeeDto;
@{
    ViewData["Title"] = "Create";
}
<div class="justify-content-center align-content-center mt-3">
    <h1 class="col-8 m-4">Create New Employee</h1>
    <form method="post" asp-action="Create" class="col-6">
        @* Defualt Method ==> Post *@
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>  @*  Code Is Required{Validation} *@
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span> @*  Name Is Required{Validation} *@
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="Address">Address</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="PhoneNumber">PhoneNumber</label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div><div class="form-group mb-1">
            <label class="form-label" asp-for="Age">Age</label>
            <input asp-for="Age" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="Salary">Salary</label>
            <input asp-for="Salary" class="form-control" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="HiringDate">HiringDate</label>
            <input asp-for="HiringDate" class="form-control" type="date" />
            <span asp-validation-for="HiringDate" class="text-danger"></span>
        </div>
        <div class="form-group mb-1">
            <label class="form-label" asp-for="Gender">Gender</label>
            <br>
            <div class="form-check-inline">
                @foreach (Gender item in Enum.GetValues(typeof(Gender)))
                {
                    <input asp-for="Gender" class="form-check-input" type="radio" value="@item" />
                    <label class="form-check-label">@item</label>
                }
            </div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control">
                <option value="">Select Employee Type</option>
            </select>
            <span asp-validation-for="EmployeeType" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <input asp-for="IsActive" class="form-check-input"/>
            <label class="col-form-label" asp-for="IsActive"> Is Active</label>
        </div>
        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" />
            <a asp-action="Index" class="btn btn-dark">Back To List</a>
        </div>
    </form>
</div>

