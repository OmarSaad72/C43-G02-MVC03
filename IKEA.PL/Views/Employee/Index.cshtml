@model IEnumerable<EmployeeToReturnDto>;
@{
    ViewData["Title"] = "Index";
}

<h1 class="">All Employees</h1>
<br />
<br />
<a asp-action="Create" class="btn btn-primary">Tab To Create New Employee</a>
<br />
@if (Model.Count() > 0)
{
    <table class="table table-striped table table-hover mt-3">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.EmployeeType)</th>
                <th>@Html.DisplayNameFor(E => E.Age)</th>
                <th>@Html.DisplayNameFor(E => E.Gender)</th>
                <th>@Html.DisplayNameFor(E => E.Salary)</th>
                <th>@Html.DisplayNameFor(E => E.IsActive)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var Employee in Model)
            {
                var modalId = $"deleteModal_{Employee.Id}";
                <tr>
                    <td>@Employee.Name</td>
                    <td>@Html.DisplayFor(e => Employee.Email)</td>
                    <td>@Employee.EmployeeType</td>
                    <td>@Employee.Age</td>
                    <td>@Employee.Gender</td>
                    <td>@Html.DisplayFor(e => Employee.Salary)</td>
                    <td>@Employee.IsActive</td>
                    <partial name="_ButtonPartial" model="Employee.Id" />
                    @*     @{ *@
                    @*         Html.RenderPartial("_ButtonPartial", Employee.Id); *@
                    @*     } *@
                    @*     @Html.Partial("_ButtonPartial", Employee.Id) *@
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#@modalId">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </td>
                </tr>
                <!-- Modal -->
                <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="exampleModalLabel_@Employee.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel_@Employee.Id">Delete Employee</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete the Employee "<strong>@Employee.Name</strong>"?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-route-id="@Employee.Id" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h3 class="text-center">No Employees Found!</h3>
    </div>
}