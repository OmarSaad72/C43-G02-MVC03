@model ForgetPasswordVM
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1>Forget Password</h1>
<div class="main-agileinfo">
    <div class="agileits-top">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="SendResetPasswordUrl" method="post">
            <label class="form-label" asp-for="Email" style="color:white">Email</label>
            <input asp-for="Email" placeholder="Enter Your Email">
            <span asp-validation-for="Email" class="text-danger"></span>
            <input type="submit" value="Submit">
        </form>
    </div>
</div>
@section Validation
{
    <partial name="_ValidationScriptsPartial" />
}
