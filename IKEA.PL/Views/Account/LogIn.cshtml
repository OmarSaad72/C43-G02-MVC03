@model LogInVM
@{
    ViewData["Title"] = "LogIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1>LogIn</h1>
<div class="main-agileinfo">
    <div class="agileits-top">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="LogIn" method="post">
            <label class="form-label" asp-for="Email" style="color:white">Email</label>
            <input asp-for="Email" placeholder="Enter Your Email">
            <span asp-validation-for="Email" class="text-danger"></span>
            <br />
            <label class="form-label" asp-for="Password" style="color:white">Password</label>
            <input asp-for="Password" placeholder="Enter The Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <br />
            <div class="wthree-text">
                <label class="anim">
                    <input asp-for="RememberMe" class="checkbox">
                    <span>Remember Me</span>
                </label>
                <div class="clear"> </div>
            </div>
            <input type="submit" value="SIGNIN">
            <p><a asp-action="ForgetPassword">Forget Password?</a></p>
        </form>
        <p>Don't have an Account? <a asp-action="Register">Register Now!</a></p>
    </div>
</div>
@section Validation
{
    <partial name="_ValidationScriptsPartial" />
}

