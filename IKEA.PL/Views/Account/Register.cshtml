@model RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1>Register</h1>

<div class="main-agileinfo">
    <div class="agileits-top">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Register" method="post">
            <label class="form-label" asp-for="FName" style= "color:white">First Name</label>
            <input class="text" asp-for="FName" placeholder="Enter Your First Name"/>
            <span asp-validation-for="FName" class="text-danger"></span>
            <br />
            <label class="form-label" asp-for="LName" style="color:white">Last Name</label>
            <input class="text" asp-for="LName" placeholder="Enter Your Last Name"/>
            <span asp-validation-for="LName" class="text-danger"></span>
            <br />
            <label class="form-label" asp-for="Email" style="color:white">Email</label>
            <input class="text" asp-for="Email" placeholder="Enter Your Email">
            <span asp-validation-for="Email" class="text-danger"></span>
            <br />
            <label class="form-label" asp-for="Password" style="color:white">Password</label>
            <input class="text" asp-for="Password" placeholder="Enter The Password"/>
            <span asp-validation-for="Password" class="text-danger"></span>
            <br />
            <label class="form-label" asp-for="ConfirmPassword" style="color:white">Confirmm Password</label>
            <input class="text" asp-for="ConfirmPassword" placeholder="Enter The Confirm Password"/>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            <div class="wthree-text">
                <label class="anim">
                    <input asp-for="IsAgree" class="checkbox" >
                    <span>I Agree To The Terms & Conditions</span>
                </label>
                <div class="clear"> </div>
            </div>
            <input type="submit" value="SIGNUP">
        </form>
        <p>Already have an Account? <a asp-action="LogIn"> Login Now!</a></p>
    </div>
</div>
@section Validation
{
    <partial name="_ValidationScriptsPartial" />
}
